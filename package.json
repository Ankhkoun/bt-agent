{
  "name": "bt-agent",
  "version": "0.1.0",
  "private": true,
  "description": "BT — a personal AI built on the official Pi extension system",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/integration.test.mjs tests/document-read.test.mjs",
    "test:desktop": "node --test tests/desktop.test.mjs tests/desktop-proxy.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.63.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
